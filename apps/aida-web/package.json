    "check:lint": "oxlint --max-warnings=0 .",
    "check:types": "react-router typegen && tsc --noEmit",
    "check:format": "oxfmt --check .",
    "fix:lint": "oxlint --fix .",
    "fix:format": "oxfmt ."
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
