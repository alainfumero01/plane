  },
  "devDependencies": {
    "@dotenvx/dotenvx": "catalog:",
    "@plane/typescript-config": "workspace:*",
    "@react-router/dev": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-tsconfig-paths": "^5.1.4"
  }
